	(text "GPIO35-37: octal PSRAM inside the module, not usable.\nGPIO0, 3, 45, 46: strapping pins, left at their defaults\n(GPIO0: BOOT button plus the chip pull-up, as on the DevKitC-1).\nGPIO8, 9, 10, 12, 17, 18: free for later use. UART0 (GPIO43/44) is unused:\nthe console is the native USB port.\nMic on I2S0 and amplifier on I2S1 keep separate clocks,\nso full duplex can be tried later."
		(exclude_from_sim no)
		(at 20.32 231.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1b7ac305-c376-5a7a-b110-d1e49a2b0ff2")
	)
	(text "MAIN BUTTON AND RGB STATUS LED"
		(exclude_from_sim no)
		(at 210.18 126.32 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
				(color 20 120 60 1)
			)
			(justify left bottom)
		)
		(uuid "268f6e60-884a-558a-9a50-52a9d371e0fc")
	)
	(text "GAIN open: 9 dB. Fit R6 (100k to GND) for 15 dB.\nSD_MODE has a 100k pull-down inside: amplifier stays off until GPIO4 goes high (left channel)."
		(exclude_from_sim no)
		(at 213.36 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "45ab45a2-1e23-5f9c-9c7c-3dcb256ac32f")
	)
	(text "TEST POINTS AND MOUNTING"
		(exclude_from_sim no)
		(at 210.18 194.9 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
				(color 90 90 90 1)
			)
			(justify left bottom)
		)
		(uuid "49f690e2-1e19-5ff6-8b63-4df61b43c3f3")
	)
	(text "LR low: data in the left slot."
		(exclude_from_sim no)
		(at 121.92 114.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "584ec007-f268-5782-ae20-c117d0af1fd4")
	)
	(text "I2S MEMS MICROPHONE"
		(exclude_from_sim no)
		(at 121.28 72.98 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
				(color 0 120 120 1)
			)
			(justify left bottom)
		)
		(uuid "5b8906ac-bb82-5017-a03e-b08ea687d1ef")
	)
	(text "Board mounts with three M2 screws\ninto bosses in the enclosure lid."
		(exclude_from_sim no)
		(at 331.47 229.87 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5c28841e-387d-5d40-af56-b490ee274946")
	)
	(text "The LED runs from 5 V; U5 lifts the\n3.3 V data line to 5 V logic levels.\nR7 holds the line low while the\nmodule boots."
		(exclude_from_sim no)
		(at 322.58 181.61 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "66b17695-6cb8-5524-ab40-966cb97c1b3b")
	)
	(text "Speaker: 40 mm, 4 ohm, 3 W\n(Same Sky CMS-4017-34SP),\nleads on a JST PH plug."
		(exclude_from_sim no)
		(at 365.76 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "76c28a02-18c2-5644-ac92-56baa3da3fd5")
	)
	(text "5.1k Rd on each CC pin: the source supplies 5 V.\nFirmware keeps the amplifier inside a 500 mA budget\nunless a larger supply is known."
		(exclude_from_sim no)
		(at 55.88 109.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8840d415-0bd1-5801-b99f-eaf14ad78343")
	)
	(text "USB 2.0 full speed to the ESP32-S3 native USB\n(programming, console, JTAG)."
		(exclude_from_sim no)
		(at 55.88 81.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9b5f7a5a-a2c9-55bc-b12d-42ccb9bea40f")
	)
	(text "3.3 V REGULATOR"
		(exclude_from_sim no)
		(at 121.28 22.18 0)
